<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp">



        <ImageView
            android:id="@+id/logo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/main"/>


        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlay" android:layout_width="220dp" android:layout_height="64dp" android:layout_marginTop="56dp" android:background="@drawable/bg_button" android:fontFamily="sans-serif-black" android:letterSpacing="0.15" android:text="@string/play" android:textColor="@color/white" android:textSize="22sp"/>
    </LinearLayout>
    <TextView android:id="@+id/homeCoins" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="top|start" android:layout_margin="16dp" android:background="@drawable/bg_round" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:textColor="#FFFFC107" android:textSize="16sp" android:textStyle="bold"/>
    <TextView android:id="@+id/btnSettings" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|end" android:layout_margin="16dp" android:background="@drawable/bg_round" android:gravity="center" android:text="⚙" android:textColor="@color/white" android:textSize="22sp"/>
</FrameLayout>
